# Real AWS resources for `make up-aws`. Values come from `terraform output` in
# infra/terraform/envs/aws-dev (or resources you created yourself). No secrets here:
# credentials come from your AWS profile, mounted read-only into the API containers.
AWS_REGION=us-east-1
S3_BUCKET=<media bucket, terraform output media_bucket>
S3_REGION=us-east-1
SES_REGION=us-east-1
SES_CONFIGURATION_SET=<terraform output mail_configuration_set>
# Web CSP: where presigned media URLs point (virtual-hosted bucket origin).
MEDIA_ORIGINS=https://<media bucket>.s3.us-east-1.amazonaws.com
MAIL_FROM=Euron Open LMS <no-reply@<your verified SES domain>>
# Values here win over the compose defaults (make up-aws reads this file as an
# --env-file). Payments, AI and video stay on the local stubs unless you set the real
# STRIPE_*, RAZORPAY_*, OPENAI_* and EVS_* values in your (git-ignored) .env.aws.
# PRODUCT_NAME=Euron Open LMS
# LOG_LEVEL=info
# TOTP_ENCRYPTION_KEY comes from deploy/compose/.env (make env), like the other
# local secrets; do not put it here.
