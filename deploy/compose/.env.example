# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
LMS_JWT_SECRET=replace-with-output-of-make-env
LMS_REFRESH_SECRET=replace-with-output-of-make-env
LMS_DEMO_PASSWORD=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
LMS_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env
# Shared by the API and the local stub server (apps/stubs). Not real credentials.
LMS_STRIPE_SECRET_KEY=replace-with-output-of-make-env
LMS_STRIPE_WEBHOOK_SECRET=replace-with-output-of-make-env
LMS_RAZORPAY_KEY_SECRET=replace-with-output-of-make-env
LMS_RAZORPAY_WEBHOOK_SECRET=replace-with-output-of-make-env
LMS_EVS_PLAYBACK_KEY=replace-with-output-of-make-env
LMS_EVS_WEBHOOK_SECRET=replace-with-output-of-make-env

# Use real providers instead of the stubs (see docs/guides/payments.md and
# docs/guides/video-with-evs.md). Each one set here wins over the stub default.
# STRIPE_API_BASE=https://api.stripe.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_API_BASE=https://api.razorpay.com
# RAZORPAY_CHECKOUT_SCRIPT_URL=https://checkout.razorpay.com/v1/checkout.js
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# EVS_BASE_URL=http://host.docker.internal:4500
# EVS_PLAYBACK_KEY=evs_...        (scope playback:mint)
# EVS_READ_KEY=evs_...            (scope videos:read, optional: the admin video picker)
# EVS_WEBHOOK_SECRET=whsec_...
# VIDEO_ORIGINS=http://localhost:4500 http://localhost:4566
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# PUSH_PROVIDER=fcm
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# Optional overrides (host ports and names)
# LMS_PRODUCT_NAME=Euron Open LMS
# LMS_LOG_LEVEL=info
# LMS_WEB_PORT=3530
# LMS_API_PORT=5026
# LMS_PG_PORT=5492
# LMS_REDIS_PORT=6429
# LMS_MAILPIT_PORT=8046
# LMS_SMTP_PORT=1046
# LMS_FLOCI_PORT=4597
# LMS_STUB_PORT=5119
